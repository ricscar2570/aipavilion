{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Pavilion Sprint 4.5G Evidence",
  "type": "object",
  "required": [
    "schemaVersion",
    "kind",
    "release",
    "commit",
    "environment",
    "startedAt",
    "completedAt",
    "status"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "type": "string"
    },
    "release": {
      "type": "string"
    },
    "commit": {
      "type": "string"
    },
    "environment": {
      "type": "string"
    },
    "runId": {
      "type": "string"
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "completedAt": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": ["PASS", "FAIL", "PENDING", "RUNNING"]
    },
    "summary": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
